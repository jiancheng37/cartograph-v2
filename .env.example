# API service
NODE_ENV=development
PORT=4310
DATABASE_URL=postgresql://postgres:password@localhost:5432/cartograph
SUPABASE_URL=https://your-project.supabase.co
CARTOGRAPH_WEB_ORIGIN=http://localhost:5173
CARTOGRAPH_MCP_URL=http://localhost:4310/mcp
DB_POOL_SIZE=10

# Vite web build (prefixes are intentionally public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_API_URL=http://localhost:4310
VITE_APP_URL=http://localhost:5173/app
VITE_MARKETING_URL=http://localhost:5173/public
# Set to "app" for the app.cartograph.com deployment and "marketing" for cartograph.com.
VITE_CARTOGRAPH_SURFACE=app
